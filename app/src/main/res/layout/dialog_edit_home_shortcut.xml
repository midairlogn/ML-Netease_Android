<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_shortcut_editor_title"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Edit Shortcut"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true" />

    <ImageButton
        android:id="@+id/btn_close_edit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/text_primary"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:contentDescription="Close" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_shortcut_editor_title"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/input_shortcut_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Shortcut Title"
            android:inputType="text" />

        <RadioGroup
            android:id="@+id/group_shortcut_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_shortcut_playlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Playlist" />

            <RadioButton
                android:id="@+id/radio_shortcut_album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Album" />
        </RadioGroup>

        <EditText
            android:id="@+id/input_shortcut_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Playlist or Album ID / URL"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_save_shortcut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/brand_primary" />
    </LinearLayout>
</RelativeLayout>
