<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Highlight Background (Behind RecyclerView) -->
    <View
        android:id="@+id/lyrics_highlight_bg"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="2dp"
        android:background="@drawable/shape_highlight_bg"
        android:visibility="gone"/>

    <com.midairlogn.mlnetease.shared.ui.HuaweiSafeRecyclerView
        android:id="@+id/recycler_lyrics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingHorizontal="8dp"
        android:overScrollMode="never" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lyrics_timeline_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:clickable="false"
        android:focusable="false"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/lyrics_timeline_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/lyrics_timeline_line"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/shape_dashed_line"
            android:layerType="software"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/lyrics_timeline_play"
            app:layout_constraintStart_toEndOf="@id/lyrics_timeline_time"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageButton
            android:id="@+id/lyrics_timeline_play"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play_from_lyric_timeline"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_primary"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
