<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <LinearLayout
        android:id="@+id/settings_inner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MUSIC_U Cookie"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/input_music_u"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste MUSIC_U cookie here"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/search_background"
            android:padding="12dp"
            android:inputType="textPassword"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search Result Limit (Default 10)"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/input_search_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter limit (e.g. 10)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/search_background"
            android:padding="12dp"
            android:inputType="number"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Volume"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <SeekBar
                android:id="@+id/seekbar_app_volume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"/>

            <TextView
                android:id="@+id/text_app_volume_value"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="64dp"
                android:gravity="center"
                android:layout_marginStart="12dp"
                android:paddingHorizontal="12dp"
                android:text="80%"
                android:textColor="@color/text_primary"
                android:background="@drawable/search_background"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio Quality"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <RadioGroup
            android:id="@+id/quality_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/quality_standard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Standard"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/brand_primary"
                android:paddingVertical="8dp"/>

            <RadioButton
                android:id="@+id/quality_higher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Higher"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/brand_primary"
                android:paddingVertical="8dp"/>

            <RadioButton
                android:id="@+id/quality_exhigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Extreme"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/brand_primary"
                android:paddingVertical="8dp"/>

            <RadioButton
                android:id="@+id/quality_lossless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lossless"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/brand_primary"
                android:paddingVertical="8dp"/>

            <RadioButton
                android:id="@+id/quality_hires"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hi-Res"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/brand_primary"
                android:paddingVertical="8dp"/>

            <RadioButton
                android:id="@+id/quality_sky"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sky (Immersive)"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/brand_primary"
                android:paddingVertical="8dp"/>
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lyric Translation Integration"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>

            <Switch
                android:id="@+id/switch_translation_integration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Floating Window Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Desktop Floating Lyrics"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>

            <Switch
                android:id="@+id/switch_floating_lyrics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_floating_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="24dp">

             <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lyric Highlight Color"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>

             <!-- Simple Color Selection for Main Settings -->
             <LinearLayout
                 style="?android:attr/buttonBarStyle"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:orientation="horizontal">

                 <Button
                     android:id="@+id/btn_color_red"
                     style="?android:attr/buttonBarButtonStyle"
                     android:layout_width="40dp"
                     android:layout_height="40dp"
                     android:backgroundTint="#F44336"
                     android:layout_marginEnd="8dp" />

                 <Button
                     android:id="@+id/btn_color_blue"
                     style="?android:attr/buttonBarButtonStyle"
                     android:layout_width="40dp"
                     android:layout_height="40dp"
                     android:backgroundTint="#2196F3"
                     android:layout_marginEnd="8dp" />

                 <Button
                     android:id="@+id/btn_color_green"
                     style="?android:attr/buttonBarButtonStyle"
                     android:layout_width="40dp"
                     android:layout_height="40dp"
                     android:backgroundTint="#4CAF50"
                     android:layout_marginEnd="8dp" />

                 <Button
                     android:id="@+id/btn_color_yellow"
                     style="?android:attr/buttonBarButtonStyle"
                     android:layout_width="40dp"
                     android:layout_height="40dp"
                     android:backgroundTint="#FFEB3B"
                     android:layout_marginEnd="8dp" />

                 <Button
                     android:id="@+id/btn_color_purple"
                     style="?android:attr/buttonBarButtonStyle"
                     android:layout_width="40dp"
                     android:layout_height="40dp"
                     android:backgroundTint="#9C27B0"
                     android:layout_marginEnd="8dp"/>
             </LinearLayout>

             <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Font Size"
                android:textColor="@color/text_primary"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"/>

             <LinearLayout
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:gravity="center_vertical">
                 <Button
                     android:id="@+id/btn_size_minus"
                     android:layout_width="50dp"
                     android:layout_height="wrap_content"
                     android:text="-"/>
                 <TextView
                     android:id="@+id/text_font_size"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:text="16"
                     android:textColor="@color/text_primary"
                     android:layout_marginHorizontal="16dp"/>
                 <Button
                     android:id="@+id/btn_size_plus"
                     android:layout_width="50dp"
                     android:layout_height="wrap_content"
                     android:text="+"/>
             </LinearLayout>

             <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preview"
                android:textColor="@color/text_primary"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"/>

             <FrameLayout
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:background="@drawable/bg_floating_window"
                 android:padding="12dp">
                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="vertical"
                     android:gravity="center">
                     <TextView
                         android:id="@+id/text_lyric_preview_current"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:gravity="center"
                         android:text="Current Lyric Preview"
                         android:singleLine="true"
                         android:shadowColor="#FF000000"
                         android:shadowDx="2"
                         android:shadowDy="2"
                         android:shadowRadius="4"
                         android:paddingBottom="4dp"/>
                     <TextView
                         android:id="@+id/text_lyric_preview_next"
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:gravity="center"
                         android:text="Next Lyric Preview"
                         android:textColor="#DDDDDD"
                         android:singleLine="true"
                         android:shadowColor="#FF000000"
                         android:shadowDx="2"
                         android:shadowDy="2"
                         android:shadowRadius="4"/>
                 </LinearLayout>
             </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/text_version_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Version: v0.0.0 | Author: Midairlogn\nML-Netease_Android © 2026 | GPLv3 LICENSE"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>
</ScrollView>
