<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary"
    android:paddingTop="16dp"
    android:paddingBottom="0dp"
    android:paddingHorizontal="16dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:background="@drawable/search_background"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_search"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@null"
            android:minHeight="40dp"
            android:inputType="text"
            android:imeOptions="actionSearch"/>

        <Button
            android:id="@+id/search_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search"
            android:textColor="@color/text_on_brand"
            android:backgroundTint="@color/brand_primary"
            android:layout_marginStart="8dp"/>

        <Button
            android:id="@+id/btn_reset_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear"
            android:textColor="@color/text_on_brand"
            android:backgroundTint="@color/text_secondary"
            android:layout_marginStart="8dp"
            android:visibility="gone"/>
    </LinearLayout>

    <RadioGroup
        android:id="@+id/search_type_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:checkedButton="@+id/radio_song"
        android:layout_marginBottom="8dp">

        <RadioButton
            android:id="@+id/radio_song"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/song"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/brand_primary"
            android:layout_marginEnd="16dp"/>

        <RadioButton
            android:id="@+id/radio_playlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playlist"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/brand_primary"
            android:layout_marginEnd="16dp"/>

        <RadioButton
            android:id="@+id/radio_album"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/album"
            android:textColor="@color/text_primary"
            android:buttonTint="@color/brand_primary"/>
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_to_shortcut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text="@string/add_shortcut"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_on_brand"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_folder"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/text_on_brand"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_collection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text="@string/share"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_on_brand"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/text_on_brand"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text="@string/play_all"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_on_brand"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/text_on_brand"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_download_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text="@string/download_all"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_on_brand"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_download_padded"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/text_on_brand"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_shortcut_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_music_note"
            android:contentDescription="@null"
            android:alpha="0.2"
            app:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hint_no_homepage_shortcut"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hint_homepage_add_shortcut"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_manage_shortcuts_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/add_shortcut"
            android:textColor="@color/text_on_brand"
            android:backgroundTint="@color/brand_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_manage_shortcuts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manage_shortcut"
            android:textColor="@color/text_on_brand"
            android:backgroundTint="@color/brand_primary"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
