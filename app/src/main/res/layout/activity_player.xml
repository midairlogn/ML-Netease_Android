<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            app:tint="@color/text_primary"
            android:contentDescription="@string/back" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_favourite_song"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/player_favourite_icon"
            android:scaleType="fitCenter"
            app:tint="@color/player_favourite_tint"
            android:contentDescription="@string/favourite" />

        <ImageButton
            android:id="@+id/btn_share_song"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_share"
            android:scaleType="fitCenter"
            app:tint="@color/text_primary"
            android:contentDescription="@string/share_song" />

        <ImageButton
            android:id="@+id/btn_download_song"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_stat_sys_download_done"
            android:scaleType="fitCenter"
            app:tint="@color/text_primary"
            android:contentDescription="@string/download" />

    </LinearLayout>

    <!-- Cover/Lyrics Area -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/player_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:overScrollMode="never"/>

    <!-- Song Info (Left aligned like Apple Music) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/player_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/song_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/player_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/artist_name"
            android:textColor="@color/text_primary"
            android:alpha="0.6"
            android:textSize="15sp"
            android:ellipsize="end"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp">

        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/playback_progress"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:thumbTint="@color/text_primary"
            android:progressTint="@color/text_primary"
            android:progressBackgroundTint="@color/text_secondary"
            android:minHeight="28dp"
            android:paddingVertical="2dp"
            android:thumbOffset="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/text_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zero_timestamp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/text_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zero_timestamp_negative"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <ImageButton
            android:id="@+id/btn_mode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/playback_mode"
            android:src="@android:drawable/ic_menu_rotate"
            android:scaleType="fitCenter"
            android:padding="4dp"
            app:tint="@color/text_primary"
            android:layout_marginEnd="10dp"/>

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous"
            android:src="@android:drawable/ic_media_previous"
            android:scaleType="fitCenter"
            app:tint="@color/text_primary"/>

        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:src="@android:drawable/ic_media_play"
            android:scaleType="fitCenter"
            app:tint="@color/text_primary"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:src="@android:drawable/ic_media_next"
            android:scaleType="fitCenter"
            app:tint="@color/text_primary"/>

        <ImageButton
            android:id="@+id/btn_playlist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_playlist"
            android:src="@android:drawable/ic_menu_agenda"
            android:scaleType="fitCenter"
            android:padding="4dp"
            app:tint="@color/text_primary"
            android:layout_marginStart="10dp"/>

    </LinearLayout>

</LinearLayout>
